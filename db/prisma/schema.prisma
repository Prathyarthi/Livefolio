generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER MODEL (JWT sessions - no Account/Session tables needed)
// ============================================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// none | pending | active — Pro is `active` (set after successful payment / webhook).
  subscriptionStatus String @default("none")

  /// Razorpay subscription ID for managing the subscription (cancel, etc.)
  razorpaySubscriptionId String?

  /// Provider cancellation is complete; paid Pro access remains until the period end.
  subscriptionCancelAtPeriodEnd Boolean   @default(false)
  subscriptionCurrentPeriodEnd  DateTime?

  welcomeEmailSentAt           DateTime?
  noPortfolioReminderSentAt    DateTime?
  unpublishedReminderSentAt    DateTime?

  portfolio               Portfolio?
  billingSubscriptions    BillingSubscription[]
  billingCheckout         BillingCheckoutAttempt?
  orgBillingCheckouts     OrgBillingCheckoutAttempt[]
  billingPayments         BillingPayment[]

  organizationMembers OrganizationMember[]
  jobsCreated         Job[]
  applications        Application[]
  recruiterNotes      RecruiterNote[]
  emailSendLogs        EmailSendLog[]
  storedFiles          StoredFile[]

  @@map("users")
}

model BillingSubscription {
  id                     String    @id @default(uuid())
  userId                 String
  /// Set for organization (hiring) subscriptions; null for personal Pro.
  organizationId         String?
  providerSubscriptionId String    @unique
  providerPlanId         String
  interval               String
  status                 String
  cancelAtPeriodEnd      Boolean   @default(false)
  currentPeriodEnd       DateTime?
  lastEventAt            DateTime?
  lastEventId            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     BillingPayment[]

  @@index([userId, status])
  @@index([organizationId, status])
  @@map("billing_subscriptions")
}

/// Org checkout attempts (separate from personal BillingCheckoutAttempt).
model OrgBillingCheckoutAttempt {
  id                     String   @id @default(uuid())
  organizationId         String   @unique
  userId                 String
  providerSubscriptionId String?  @unique
  providerPlanId         String
  interval               String
  status                 String   @default("creating")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("org_billing_checkout_attempts")
}

model BillingCheckoutAttempt {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  providerSubscriptionId String?  @unique
  providerPlanId         String
  interval               String
  status                 String   @default("creating")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_checkout_attempts")
}

model BillingPayment {
  providerPaymentId      String   @id
  userId                 String
  billingSubscriptionId  String
  providerSubscriptionId String
  status                 String
  createdAt              DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription BillingSubscription @relation(fields: [billingSubscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerSubscriptionId])
  @@map("billing_payments")
}

model BillingWebhookEvent {
  providerEventId        String   @id
  eventType              String
  providerSubscriptionId String?
  occurredAt             DateTime
  processedAt            DateTime @default(now())

  @@index([providerSubscriptionId, occurredAt])
  @@map("billing_webhook_events")
}

// ============================================================
// PORTFOLIO MODELS
// ============================================================

model Portfolio {
  id     String  @id @default(uuid())
  userId String  @unique
  slug   String? @unique

  title     String  @default("")
  headline  String  @default("")
  summary   String  @default("") @db.Text
  avatarUrl String?
  resumeUrl String?

  templateId  String  @default("pulse")
  isPublished Boolean @default(false)

  metaTitle       String?
  metaDescription String?

  contactEmail String?
  phone        String?
  location     String?
  websiteUrl   String?

  customization Json @default("{}")

  /// Project IDs selected for Microlink live previews (compact; resolve liveUrl at render time).
  livePreviewProjectIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  projects       Project[]
  articles       Article[]
  socialProfiles SocialProfile[]
  certifications Certification[]
  achievements   Achievement[]
  customSections CustomSection[]
  views          PortfolioView[]
  clicks         PortfolioClick[]
  storedFiles    StoredFile[]

  @@index([slug])
  @@map("portfolios")
}

model PortfolioView {
  id          String   @id @default(uuid())
  portfolioId String
  viewedAt    DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, viewedAt])
  @@map("portfolio_views")
}

model PortfolioClick {
  id          String   @id @default(uuid())
  portfolioId String
  /// project_live | project_source | article | social | custom | outbound
  type        String
  /// Human-readable label (project title, platform, article title, etc.)
  label       String   @default("")
  url         String
  targetId    String?
  clickedAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, clickedAt])
  @@index([portfolioId, type, clickedAt])
  @@map("portfolio_clicks")
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model Experience {
  id          String    @id @default(uuid())
  portfolioId String
  company     String
  role        String
  description String    @db.Text
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  logoUrl     String?
  sortOrder   Int       @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Education {
  id          String    @id @default(uuid())
  portfolioId String
  institution String
  degree      String
  field       String?
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  gpa         String?
  sortOrder   Int       @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Skill {
  id          String @id @default(uuid())
  portfolioId String
  name        String
  category    String @default("general")
  level       Int?
  sortOrder   Int    @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Project {
  id          String   @id @default(uuid())
  portfolioId String
  title       String
  description String   @db.Text
  imageUrl    String?
  liveUrl     String?
  sourceUrl   String?
  techStack   String[]
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)

  githubStars Int?
  githubForks Int?
  language    String?

  portfolio   Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  storedFiles StoredFile[]

  @@map("projects")
}

model Article {
  id          String    @id @default(uuid())
  portfolioId String
  title       String
  description String    @db.Text
  url         String
  tags        String[]
  publishedAt DateTime?
  readTime    Int?
  sortOrder   Int       @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("articles")
}

model SocialProfile {
  id          String  @id @default(uuid())
  portfolioId String
  platform    String
  url         String
  username    String?

  cachedStats Json?
  lastFetched DateTime?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, platform])
  @@map("social_profiles")
}

model Certification {
  id          String    @id @default(uuid())
  portfolioId String
  name        String
  issuer      String
  issueDate   DateTime?
  expiryDate  DateTime?
  url         String?
  sortOrder   Int       @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Achievement {
  id          String    @id @default(uuid())
  portfolioId String
  title       String    @db.Text
  date        DateTime?
  sortOrder   Int       @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model CustomSection {
  id          String @id @default(uuid())
  portfolioId String
  sectionType String
  label       String
  items       Json   @default("[]")
  sortOrder   Int    @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, sectionType])
  @@map("custom_sections")
}

// ============================================================
// TEMPLATE REGISTRY (seeded)
// ============================================================

model Template {
  id          String @id
  name        String
  description String
  previewUrl  String
  category    String @default("general")

  @@map("templates")
}

// ============================================================
// HIRING — Organizations, Jobs, Applications
// ============================================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  logoUrl     String?
  brandColor  String?
  websiteUrl  String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// none | pending | active — Org Pro is `active`.
  subscriptionStatus String @default("none")
  razorpaySubscriptionId String?
  subscriptionCancelAtPeriodEnd Boolean   @default(false)
  subscriptionCurrentPeriodEnd  DateTime?

  members              OrganizationMember[]
  jobs                 Job[]
  billingSubscriptions BillingSubscription[]
  billingCheckout      OrgBillingCheckoutAttempt?
  storedFiles          StoredFile[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  /// owner | admin | recruiter | hiring_manager
  role           String   @default("recruiter")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Job {
  id             String @id @default(uuid())
  organizationId String
  createdById    String

  title       String
  slug        String  @unique
  description String  @db.Text
  department  String?
  /// full_time | part_time | contract | internship
  employmentType String?
  location       String?
  /// remote | hybrid | on_site
  workplaceType String?

  experienceMin Int?
  experienceMax Int?
  salaryMin     Int?
  salaryMax     Int?
  salaryCurrency String? @default("USD")

  responsibilities String? @db.Text
  qualifications   String? @db.Text
  benefits         String? @db.Text

  applicationDeadline DateTime?
  /// draft | published | paused | closed
  status      String    @default("draft")
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  requirements JobRequirement[]
  applications Application[]
  storedFiles  StoredFile[]

  @@index([organizationId, status])
  @@index([slug])
  @@index([status, publishedAt])
  @@map("jobs")
}

model JobRequirement {
  id          String  @id @default(uuid())
  jobId       String
  /// required | preferred
  type        String
  /// skill | experience | education | other
  category    String  @default("skill")
  label       String
  description String?
  sortOrder   Int     @default(0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_requirements")
}

model Application {
  id          String  @id @default(uuid())
  jobId       String
  userId      String
  portfolioId String?

  /// applied | under_review | shortlisted | interview | offer | hired | rejected
  status String @default("applied")
  /// new | reviewing | shortlisted | interview | offer | hired | rejected
  stage  String @default("new")

  /// Soft shortlist flag — independent of pipeline stage for compare views
  shortlisted   Boolean   @default(false)
  shortlistedAt DateTime?

  coverNote   String?  @db.Text
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job      Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot ApplicationSnapshot?
  notes    RecruiterNote[]

  @@unique([jobId, userId])
  @@index([userId, submittedAt])
  @@index([jobId, stage])
  @@index([jobId, status])
  @@index([jobId, shortlisted])
  @@map("applications")
}

model ApplicationSnapshot {
  id            String   @id @default(uuid())
  applicationId String   @unique
  /// Immutable copy of the candidate Livefolio at submission time
  data          Json
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_snapshots")
}

model StoredFile {
  id             String   @id @default(uuid())
  key            String   @unique
  /// resume | project_thumb | job_source
  kind           String
  contentType    String
  sizeBytes      Int
  userId         String?
  organizationId String?
  portfolioId    String?
  projectId      String?
  jobId          String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([projectId, kind])
  @@index([jobId, kind])
  @@map("stored_files")
}

model RecruiterNote {
  id            String   @id @default(uuid())
  applicationId String
  authorId      String
  body          String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([authorId])
  @@map("recruiter_notes")
}

// ============================================================
// EMAIL
// ============================================================

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  bodyHtml  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[]

  @@map("email_templates")
}

model EmailCampaign {
  id             String   @id @default(uuid())
  templateId     String?
  subject        String
  bodyHtml       String   @db.Text
  /// draft | sending | sent | failed
  status         String   @default("draft")
  createdByEmail String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs     EmailSendLog[]

  @@index([createdAt])
  @@map("email_campaigns")
}

model EmailSendLog {
  id         String   @id @default(uuid())
  userId     String?
  toEmail    String
  /// welcome | no_portfolio | unpublished | blast
  type       String
  campaignId String?
  resendId   String?
  /// sent | failed
  status     String
  error      String?
  createdAt  DateTime @default(now())

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([toEmail, createdAt])
  @@index([campaignId])
  @@map("email_send_logs")
}
